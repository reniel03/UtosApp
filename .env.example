# Gmail account used to send verification codes
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
GMAIL_SENDER_NAME=UtosApp
SESSION_SECRET=replace-with-a-random-secret
# Keep the Firebase service-account JSON outside this repository.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/utosapp-service-account.json
FIREBASE_DATABASE_URL=https://utosapp-fd977-default-rtdb.firebaseio.com
# PayMongo Hosted Checkout (use test keys while developing).
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYMONGO_WEBHOOK_SECRET=replace_with_your_test_webhook_secret
PAYMONGO_EWALLET_METHOD_TYPES=gcash,paymaya,qrph
PAYMONGO_BANK_METHOD_TYPES=dob,dob_ubp,brankas
PAYMONGO_CARD_METHOD_TYPES=card
PAYMONGO_PASS_ON_FEES=true
APP_BASE_URL=http://localhost:3000
